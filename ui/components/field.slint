import { Theme } from "../theme.slint";
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label:root.placeholder;
    in property <bool> active:root.text!="";
    callback accepted();
    height:28px;min-width:60px;preferred-width:120px;
    border-radius:6px;border-width:1px;border-color:input.has-focus ? Theme.accent : root.active ? Theme.selected-border : Theme.control-border;
    background:root.active ? Theme.selected : Theme.raised;
    forward-focus:input;
    if root.text=="": Text { x:9px;width:parent.width - 18px;height:parent.height;text:root.placeholder;color:Theme.muted;font-size:12px;vertical-alignment:center;overflow:elide; }
    input := TextInput { x:9px;y:0px;width:parent.width - 18px;height:parent.height;text <=> root.text;color:root.active ? #8cc2ff : Theme.foreground;font-size:12px;vertical-alignment:center;single-line:true;selection-background-color:Theme.selected-border;selection-foreground-color:Theme.foreground;accessible-label:root.label;accepted=>{root.accepted();} }
}
