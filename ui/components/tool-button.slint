import { KeyHint } from "key-hint.slint";
import { Theme } from "../theme.slint";
export component ToolButton inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <image> icon;
    in property <string> hint;
    in property <[string]> keys;
    in property <length> content-inset:10px;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <bool> chip;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> icon-only;
    in property <bool> align-left;
    in property <bool> show-icon: root.icon.width > 0;
    callback clicked();
    height: 28px;
    min-width: root.icon-only ? 28px : content.preferred-width + 2 * root.content-inset;
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    border-radius: 6px;
    border-width: root.chip || focus.has-focus ? 1px : 0px;
    border-color: focus.has-focus ? Theme.accent : root.active ? Theme.selected-border : Theme.control-border;
    background: root.primary ? #2f6fd0 : root.active ? Theme.selected : touch.has-hover && root.enabled ? Theme.hover : root.chip ? Theme.raised : transparent;
    private property <color> ink: !root.enabled ? Theme.disabled : root.primary ? white : root.danger ? Theme.danger : root.active ? #8cc2ff : touch.has-hover ? Theme.foreground : Theme.secondary;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    forward-focus: focus;
    content := HorizontalLayout {
        x:root.icon-only ? 6px : root.content-inset; y:0px; width:parent.width - 2 * self.x;height:parent.height;spacing:6px;
        alignment: root.hint!="" || root.keys.length>0 ? stretch : root.align-left ? start : center;
        if root.show-icon: Rectangle { width:16px;
            Image { y:(parent.height - 16px)/2;width:16px;height:16px;source:root.icon;colorize:root.ink;image-fit:contain; }
        }
        if root.text != "" && !root.icon-only: Text { text:root.text;color:root.ink;font-size:12px;vertical-alignment:center;overflow:elide; }
        if root.hint != "" || root.keys.length>0: Rectangle { horizontal-stretch:1; }
        if root.hint != "": Text { text:root.hint;color:root.enabled ? Theme.muted : Theme.disabled;font-size:11px;vertical-alignment:center; }
        if root.keys.length>0: KeyHint { keys:root.keys; }
    }
    focus := FocusScope { enabled:root.enabled;key-pressed(event)=>{if event.text==Key.Return || event.text==" " {root.clicked();return accept;}return reject;} }
    touch := TouchArea { enabled:root.enabled;mouse-cursor:pointer;clicked=>{focus.focus();root.clicked();} }
}
export component Separator inherits Rectangle {
    width:1px;min-height:16px;
    Rectangle { y:(parent.height - 16px)/2;width:1px;height:16px;background:Theme.control-border; }
}
