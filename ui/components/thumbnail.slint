import { Theme } from "../theme.slint";
import { ImageRow } from "../media-types.slint";
import { Icons } from "../icons.slint";
export component Thumbnail inherits Rectangle {
    in property <ImageRow> entry;
    in property <bool> selected;
    callback activated();
    accessible-role:button;
    accessible-label:root.entry.name + (root.entry.paired ? " RAW + JPEG" : "") + (root.entry.rejected ? " rejected" : "");
    forward-focus:focus;
    thumb-border := Rectangle { x:2px;y:2px;width:parent.width - 4px;height:self.width;border-radius:8px;border-width:root.selected || focus.has-focus ? 2px : 0px;border-color:Theme.accent;background:transparent; }
    thumbnail := Rectangle {
        x:5px;y:5px;width:parent.width - 10px;height:self.width;border-radius:6px;clip:true;background:Theme.button;
        Image { x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;width:parent.width;height:parent.height;source:root.entry.thumbnail;image-fit:root.entry.video ? contain : cover;transform-rotation:root.entry.rotation * 90deg;opacity:root.entry.rejected ? 0.35 : 1; }
        if root.entry.thumbnail.width==0: Image { x:(parent.width - 28px)/2;y:(parent.height - 28px)/2;width:28px;height:28px;source:root.entry.video ? Icons.play : Icons.grid;colorize:Theme.disabled; }
        if root.entry.rejected || root.entry.rating>0: Rectangle {
            x:6px;y:6px;height:18px;width:badge.preferred-width + 12px;border-radius:4px;background:#0a0b0dc7;
            badge := Text { x:6px;height:parent.height;text:root.entry.rejected ? "Rejected" : "★ " + root.entry.rating;color:root.entry.rejected ? Theme.danger : Theme.foreground;font-size:11px;vertical-alignment:center; }
        }
        if root.entry.paired || root.entry.video || root.entry.raw: Rectangle {
            x:6px;y:parent.height - 24px;height:18px;width:kind.preferred-width + 12px;border-radius:4px;background:#0a0b0dc7;
            kind := Text { x:6px;height:parent.height;text:root.entry.paired ? "RAW + JPEG" : root.entry.format + (root.entry.duration!="" ? " · " + root.entry.duration : "");color:Theme.foreground;font-size:11px;vertical-alignment:center; }
        }
    }
    Text { x:5px;y:thumbnail.y + thumbnail.height + 8px;width:parent.width - 10px;height:18px;text:root.entry.name;color:root.selected ? Theme.foreground : Theme.secondary;font-size:12px;overflow:elide; }
    focus := FocusScope { key-pressed(event)=>{if event.text==Key.Return || event.text==" "{root.activated();return accept;}return reject;} }
    TouchArea { mouse-cursor:pointer;clicked=>{focus.focus();root.activated();} }
}
