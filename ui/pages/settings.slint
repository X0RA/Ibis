import { ScrollView } from "std-widgets.slint";
import { ToolButton } from "../components/tool-button.slint";
import { Icons } from "../icons.slint";
import { Theme } from "../theme.slint";

component SettingsNote inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    height:max(18px,note-text.preferred-height);
    Image { x:0px;y:2px;width:14px;height:14px;source:root.icon;colorize:Theme.muted;image-fit:contain; }
    note-text := Text { x:24px;y:0px;width:parent.width - 24px;height:self.preferred-height;text:root.text;wrap:word-wrap;color:#8e959f;font-size:12px; }
}

export component SettingsPage inherits Rectangle {
    in property <bool> write-metadata;
    in property <bool> enabled:true;
    in property <bool> return-to-viewer;
    in property <string> status;
    in property <string> app-version;
    callback change-mode(bool);
    callback close();
    background:Theme.background;
    forward-focus:app-records;
    init=>{if root.write-metadata {file-metadata.focus();}else{app-records.focus();}}

    Rectangle { x:0px;y:0px;width:parent.width;height:34px;background:Theme.toolbar;
        HorizontalLayout { x:12px;y:0px;height:33px;spacing:8px;alignment:start;
            ToolButton { text:root.return-to-viewer ? "Viewer" : "Library";icon:Icons.back;height:24px;content-inset:8px;clicked=>{root.close();} }
            Rectangle { width:1px;height:14px;background:#262a30; }
            Text { text:"Settings";color:Theme.foreground;font-size:12px;font-weight:500;vertical-alignment:center; }
        }
        Rectangle { y:parent.height - 1px;width:parent.width;height:1px;background:#1a1c20; }
    }
    settings-scroll := ScrollView {
        x:0px;y:34px;width:parent.width;height:parent.height - 34px;
        horizontal-scrollbar-policy:always-off;
        content-width:self.visible-width;content-height:body.height + 96px;
        body := VerticalLayout {
            x:(settings-scroll.visible-width - self.width)/2;y:48px;
            width:min(680px,settings-scroll.visible-width - 40px);
            height:self.preferred-height;spacing:32px;alignment:start;
            Text { text:"Settings";color:Theme.foreground;font-size:20px;font-weight:600; }
            VerticalLayout { spacing:10px;
                Text { text:"RATINGS";color:Theme.muted;font-size:11px;font-weight:600;letter-spacing:0.66px; }
                ratings-card := Rectangle {
                    background:Theme.surface;border-radius:8px;border-width:1px;border-color:Theme.border;
                    height:card-header.height + notes.height + 27px;
                    card-header := Rectangle {
                        x:0px;y:0px;width:parent.width;
                        private property <bool> stacked:root.width < 700px;
                        height:self.stacked ? heading.height + storage-mode.height + 44px : max(heading.height,storage-mode.height) + 32px;
                        heading := VerticalLayout {
                            x:18px;y:16px;width:min(380px,card-header.stacked ? parent.width - 36px : storage-mode.x - 42px);
                            height:self.preferred-height;spacing:4px;
                            Text { text:"Save ratings and rejections to";color:Theme.foreground;font-size:13px;font-weight:500;wrap:word-wrap; }
                            Text { text:"App records leave your files untouched. File metadata writes the XMP rating so other apps can read it.";color:Theme.secondary;font-size:12px;wrap:word-wrap; }
                        }
                        storage-mode := Rectangle {
                            x:card-header.stacked ? 18px : parent.width - self.width - 18px;
                            y:card-header.stacked ? heading.y + heading.height + 12px : (parent.height - self.height)/2;
                            width:app-records.min-width + file-metadata.min-width + 3px;height:30px;
                            background:Theme.raised;border-width:1px;border-color:Theme.control-border;border-radius:6px;clip:true;
                            app-records := ToolButton {
                                x:1px;y:1px;width:self.min-width;height:28px;text:"App records";content-inset:12px;border-radius:0px;
                                enabled:root.enabled;active:!root.write-metadata;
                                accessible-checkable:true;accessible-checked:!root.write-metadata;
                                clicked=>{if root.write-metadata {root.change-mode(false);}}
                            }
                            Rectangle { x:app-records.x + app-records.width;y:1px;width:1px;height:28px;background:Theme.control-border; }
                            file-metadata := ToolButton {
                                x:app-records.x + app-records.width + 1px;y:1px;width:self.min-width;height:28px;text:"File metadata";content-inset:12px;border-radius:0px;
                                enabled:root.enabled;active:root.write-metadata;
                                accessible-checkable:true;accessible-checked:root.write-metadata;
                                clicked=>{if !root.write-metadata {root.change-mode(true);}}
                            }
                        }
                    }
                    Rectangle { y:card-header.height;width:parent.width;height:1px;background:Theme.border; }
                    notes := VerticalLayout {
                        x:18px;y:card-header.height + 13px;width:parent.width - 36px;height:self.preferred-height;spacing:8px;
                        SettingsNote { icon:Icons.storage-switch;text:"Switching changes where ratings are read and saved. Existing ratings are not copied across."; }
                        SettingsNote { icon:Icons.reject;text:"In file metadata, a rejection is stored as rating −1 and replaces the stars. Setting stars clears it."; }
                        SettingsNote { icon:Icons.warning;text:"Writes run in the background with ExifTool. Read-only or unsupported files show an error."; }
                        SettingsNote { icon:Icons.rotate;text:"Rotation is always kept in app records and never changes the file."; }
                        if root.status!="": Text { text:root.status;wrap:word-wrap;color:Theme.secondary;font-size:12px; }
                    }
                }
            }
            VerticalLayout { spacing:16px;
                Rectangle { height:1px;background:Theme.border; }
                HorizontalLayout { spacing:16px;
                    Text { text:"ibis";color:Theme.muted;font-size:12px; }
                    Rectangle { horizontal-stretch:1; }
                    version-label := Text { text:"Version " + root.app-version;color:Theme.muted;font-size:12px; }
                }
            }
        }
    }
}
